# Plantilla de secretos para Streamlit.
#
# NO escriba su clave aquí. Este archivo SÍ se versiona.
#
# Uso correcto:
#   1. Copie esta plantilla:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   2. Ponga su clave real en `.streamlit/secrets.toml`, que está ignorado por git.
#
# En Streamlit Community Cloud no se usa ningún archivo: pegue el par
# clave-valor en Settings → Secrets de la app desplegada.
#
# Obtenga una clave gratuita en https://console.groq.com/keys

GROQ_API_KEY = "reemplace-por-su-clave-de-groq"
