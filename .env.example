# Plantilla de variables de entorno para ejecución LOCAL.
#
# Copie este archivo a `.env` y ponga su clave real.
# `.env` está en .gitignore: NUNCA se sube al repositorio.
#
#   cp .env.example .env
#
# Obtenga una clave gratuita en https://console.groq.com/keys

GROQ_API_KEY=gsk_reemplace_esto_por_su_clave_real
